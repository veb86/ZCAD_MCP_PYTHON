# Copy to .env (next to server.py) and adjust. Variables already set in the
# environment (e.g. in the MCP client config) take precedence over this file.

# ZCAD Bridge (HTTPStart in ZCAD), endpoint /ipc
ZCAD_BRIDGE_URL=http://127.0.0.1:5000
#ZCAD_BRIDGE_TOKEN=
#ZCAD_BRIDGE_TIMEOUT_SEC=35

# Workspace (exported DXF files) and skills directory; relative paths are
# resolved against the project directory
ZCAD_MCP_WORKSPACE=./workspace
ZCAD_MCP_SKILLS=./skills

# Limits
ZCAD_MCP_MAX_SEGMENTS=200
ZCAD_MCP_SKILL_TIMEOUT_SEC=60
#ZCAD_MCP_MAX_RESULT_BYTES=200000
#ZCAD_MCP_SKILL_MEMORY_MB=2048
#ZCAD_MCP_MAX_DRAW_LINES=10000

# Bridge command mapping (to be agreed with the ZCAD Bridge)
#ZCAD_EXPORT_COMMAND=EXPORT
#ZCAD_EXPORT_WAIT_SEC=30
#ZCAD_DRAW_MODE=batch
#ZCAD_BATCH_CHUNK_SIZE=500

#ZCAD_MCP_LOG_LEVEL=INFO
